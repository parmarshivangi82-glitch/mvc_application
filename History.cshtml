@model IReadOnlyList<PdfHistoryItem>
@{
    ViewData["Title"] = "Upload History";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Upload History</h1>
        <p class="text-muted mb-0">Your extracted PDF previews and exports are saved here.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Pdf" asp-action="Upload">Upload PDF</a>
</div>

@if (Model.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5 text-muted">No files uploaded yet.</div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">File name</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < Model.Count; index++)
                    {
                        var pdf = Model[index];
                        <tr>
                            <th scope="row">@(index + 1)</th>
                            <td class="text-break">@pdf.FileName</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Pdf" asp-action="Details" asp-route-id="@pdf.Id">View</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Pdf" asp-action="Download" asp-route-id="@pdf.Id">Download</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
